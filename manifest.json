{
  "manifest_version": 3,
  "name": "Oryx Diff",
  "version": "0.1.17",
  "description": "Compare two revisions of a ZSA Oryx layout and highlight changed keys per layer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://configure.zsa.io/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
